{
	"name": "n8n-nodes-klussenbeheer",
	"version": "0.1.1",
	"description": "n8n community nodes for Klussenbeheer: search and manage jobs, customers and the planning.",
	"license": "MIT",
	"homepage": "https://samdesk.nl/klussenbeheer/",
	"keywords": [
		"n8n-community-node-package",
		"klussenbeheer",
		"jobs",
		"customers",
		"planning",
		"field service"
	],
	"author": {
		"name": "Samautomation",
		"email": "npm@samautomation.work"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/smrht/n8n-nodes-klussenbeheer.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/KlussenbeheerApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Klussenbeheer/Klussenbeheer.node.js",
			"dist/nodes/KlussenbeheerTrigger/KlussenbeheerTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.52.2",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
